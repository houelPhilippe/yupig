  <link rel="stylesheet" href="$library-basedir$resources/dsfr/dist/dsfr.main.css">
  <link rel="stylesheet" href="$library-basedir$resources/dsfr/dist/utility/utility.main.css">

$if(highlighting-css)$
  <style>
$highlighting-css$
  </style>
$endif$
$for(header-includes)$
  $header-includes$
$endfor$

  <style>
    /* Ajustements du rendu Pandoc pour le DSFR */
    #TOC ul { list-style-type: none; padding-left: 1rem; margin: 0; }
    #TOC > ul { padding-left: 0; }
    #TOC li { margin-bottom: 1px; }
    #TOC a { text-decoration: none; color: var(--text-action-high-blue-france); font-size: 0.875rem; display: block; padding: 1px 0; line-height: 1.25; background-image: none !important; border: none !important; box-shadow: none !important; }
    #TOC a:hover { text-decoration: underline; background-color: var(--background-alt-grey); }
    #TOC a.active { font-weight: 700; color: var(--text-active-blue-france); padding-left: 0.5rem; }
    
    .reading-content pre { background-color: var(--background-alt-grey); padding: 1rem; overflow-x: auto; border-radius: 0.25rem; margin-bottom: 1.5rem; }
    .reading-content code { font-family: "JetBrains Mono", monospace; font-size: 0.875rem; }
    .reading-content figure { text-align: center; margin: 2rem 0; }
    .reading-content figcaption { color: var(--text-mention-grey); font-size: 0.875rem; margin-top: 0.5rem; }
    .reading-content img { max-width: 100%; height: auto; border-radius: 0.25rem; }
    
    .reading-content table { border-collapse: collapse; width: 100%; margin-bottom: 1.5rem; }
    .reading-content th, .reading-content td { padding: 0.75rem; border: 1px solid var(--border-default-grey); text-align: left; }
    .reading-content th { background-color: var(--background-alt-grey); font-weight: 700; }
    
    .reading-content blockquote { padding: 0.5rem 1rem; border-left: 4px solid var(--border-default-blue-france); margin-bottom: 1.5rem; background: var(--background-alt-blue-france); }
    
    
    .reading-content img, .reading-content svg { max-width: 100% !important; height: auto !important; }
    .title-wrapper h1 { margin-top: 1.5rem; clear: both; }

        .pagebreak { display: none !important; }
    /* Cacher les niveaux profonds du TOC dynamiquement */
    #TOC[data-toc-depth="1"] ul ul,
    #TOC[data-toc-depth="2"] ul ul ul,
    #TOC[data-toc-depth="3"] ul ul ul ul,
    #TOC[data-toc-depth="4"] ul ul ul ul ul,
    #TOC[data-toc-depth="5"] ul ul ul ul ul ul { display: none; }
    
    
    /* Resizable Sidebars */
    @media (min-width: 48em) {
      .sidebar-left { flex: 0 0 var(--left-w, 320px); max-width: var(--left-w, 320px); position: relative; }
      .sidebar-right { flex: 0 0 var(--right-w, 320px); max-width: var(--right-w, 320px); position: relative; }
      .main-fluid { flex: 1 1 0%; max-width: none; min-width: 0; }
    }
    .drag { position: absolute; top: 0; width: 8px; height: 100%; cursor: col-resize; z-index: 10; transition: background 0.2s; }
    .drag:hover, .drag:active { background: var(--border-action-high-blue-france); }
    .drag.l { right: -4px; }
    .drag.r { left: -4px; }

        .sidebar-right div::-webkit-scrollbar { display: none; }
    
    /* Design Modal Paramètres */
    .custom-segmented-control { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
    .custom-segmented-control label { flex: 1; cursor: pointer; margin: 0; }
    .custom-segmented-control input { display: none; }
    .custom-segmented-control span { 
      display: block; text-align: center; padding: 0.5rem 1rem; 
      border: 1px solid var(--border-default-grey); border-radius: 0.25rem; 
      background: var(--background-default-grey); font-weight: bold;
      transition: all 0.2s; 
    }
    .custom-segmented-control input:checked + span {
      background: var(--background-active-blue-france); color: #fff; border-color: var(--background-active-blue-france);
    }
    
    
    /* Application des paramètres - FORCED WITH !IMPORTANT */
    .main-content-area[data-font-family="Serif"] .reading-content,
    .main-content-area[data-font-family="Serif"] .reading-content * { font-family: "Georgia", "Merriweather", serif !important; }
    .main-content-area[data-font-family="Sans"] .reading-content,
    .main-content-area[data-font-family="Sans"] .reading-content * { font-family: "Marianne", arial, sans-serif !important; }
    .main-content-area[data-font-family="Mono"] .reading-content,
    .main-content-area[data-font-family="Mono"] .reading-content * { font-family: "JetBrains Mono", "Courier New", monospace !important; }
    
    .main-content-area[data-font-size="S"] .reading-content,
    .main-content-area[data-font-size="S"] .reading-content p,
    .main-content-area[data-font-size="S"] .reading-content li { font-size: 0.875rem !important; line-height: 1.5 !important; }
    .main-content-area[data-font-size="M"] .reading-content,
    .main-content-area[data-font-size="M"] .reading-content p,
    .main-content-area[data-font-size="M"] .reading-content li { font-size: 1rem !important; line-height: 1.5 !important; }
    .main-content-area[data-font-size="L"] .reading-content,
    .main-content-area[data-font-size="L"] .reading-content p,
    .main-content-area[data-font-size="L"] .reading-content li { font-size: 1.125rem !important; line-height: 1.6 !important; }
    .main-content-area[data-font-size="XL"] .reading-content,
    .main-content-area[data-font-size="XL"] .reading-content p,
    .main-content-area[data-font-size="XL"] .reading-content li { font-size: 1.3rem !important; line-height: 1.7 !important; }
    
    .main-content-area[data-line-height="Compact"] .reading-content p,
    .main-content-area[data-line-height="Compact"] .reading-content li { line-height: 1.3 !important; }
    .main-content-area[data-line-height="Normal"] .reading-content p,
    .main-content-area[data-line-height="Normal"] .reading-content li { line-height: 1.6 !important; }
    .main-content-area[data-line-height="Aere"] .reading-content p,
    .main-content-area[data-line-height="Aere"] .reading-content li { line-height: 2.0 !important; }
    
    .main-content-area[data-justify="true"] .reading-content p { text-align: justify !important; hyphens: auto !important; }
    .main-content-area[data-justify="false"] .reading-content p { text-align: left !important; }
    
        .main-content-area[data-heading-spacing="Serre"] .reading-content h1, .main-content-area[data-heading-spacing="Serre"] .reading-content h2, .main-content-area[data-heading-spacing="Serre"] .reading-content h3, .main-content-area[data-heading-spacing="Serre"] .reading-content h4, .main-content-area[data-heading-spacing="Serre"] .reading-content h5, .main-content-area[data-heading-spacing="Serre"] .reading-content h6 { margin-top: 0.5rem !important; }
    .main-content-area[data-heading-spacing="Normal"] .reading-content h1, .main-content-area[data-heading-spacing="Normal"] .reading-content h2, .main-content-area[data-heading-spacing="Normal"] .reading-content h3, .main-content-area[data-heading-spacing="Normal"] .reading-content h4, .main-content-area[data-heading-spacing="Normal"] .reading-content h5, .main-content-area[data-heading-spacing="Normal"] .reading-content h6 { margin-top: 2rem !important; }
    .main-content-area[data-heading-spacing="Aere"] .reading-content h1, .main-content-area[data-heading-spacing="Aere"] .reading-content h2, .main-content-area[data-heading-spacing="Aere"] .reading-content h3, .main-content-area[data-heading-spacing="Aere"] .reading-content h4, .main-content-area[data-heading-spacing="Aere"] .reading-content h5, .main-content-area[data-heading-spacing="Aere"] .reading-content h6 { margin-top: 4rem !important; }
    
    .main-content-area[data-para-spacing="Serre"] .reading-content p { margin-bottom: 0.5rem !important; }
    .main-content-area[data-para-spacing="Normal"] .reading-content p { margin-bottom: 1.25rem !important; }
    .main-content-area[data-para-spacing="Aere"] .reading-content p { margin-bottom: 2rem !important; }
    
    .main-content-area[data-list-spacing="Serre"] .reading-content li { margin-bottom: 0.2rem !important; padding-bottom: 0 !important; }
    .main-content-area[data-list-spacing="Normal"] .reading-content li { margin-bottom: 0.5rem !important; padding-bottom: 0 !important; }
    .main-content-area[data-list-spacing="Aere"] .reading-content li { margin-bottom: 1rem !important; padding-bottom: 0.5rem !important; }
    
    .main-content-area[data-col-width="Etroite"] .reading-content { max-width: 600px !important; margin-left: auto !important; margin-right: auto !important; }
    .main-content-area[data-col-width="Moyenne"] .reading-content { max-width: 800px !important; margin-left: auto !important; margin-right: auto !important; }
    .main-content-area[data-col-width="Large"] .reading-content { max-width: 1000px !important; margin-left: auto !important; margin-right: auto !important; }
    .main-content-area[data-col-width="XL"] .reading-content { max-width: none !important; margin-left: 0 !important; margin-right: 0 !important; }
    
    html[data-scrollbar="Visible"] .sidebar-right div::-webkit-scrollbar { display: block !important; }
    html[data-scrollbar="Visible"] .sidebar-right div { scrollbar-width: auto !important; -ms-overflow-style: auto !important; }
    html[data-scrollbar="Masque"] .sidebar-right div::-webkit-scrollbar { display: none !important; }
    html[data-scrollbar="Masque"] .sidebar-right div { scrollbar-width: none !important; -ms-overflow-style: none !important; }

    /* Cacher les niveaux profonds du TOC dynamiquement */
    #TOC[data-toc-depth="1"] ul ul,
    #TOC[data-toc-depth="2"] ul ul ul,
    #TOC[data-toc-depth="3"] ul ul ul ul,
    #TOC[data-toc-depth="4"] ul ul ul ul ul,
    #TOC[data-toc-depth="5"] ul ul ul ul ul ul { display: none; }
    
    
    /* Resizable Sidebars */
    @media (min-width: 48em) {
      .sidebar-left { flex: 0 0 var(--left-w, 320px); max-width: var(--left-w, 320px); position: relative; }
      .sidebar-right { flex: 0 0 var(--right-w, 320px); max-width: var(--right-w, 320px); position: relative; }
