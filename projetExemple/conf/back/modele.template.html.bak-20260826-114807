                      <option value="Serif">Serif (Georgia)</option>
                      <option value="Mono">Monospace (JetBrains)</option>
                    </select>
                  </div>
                  
                  <div class="fr-select-group">
                    <label class="fr-label" for="select-size">Taille du texte</label>
                    <select class="fr-select" id="select-size" name="font-size">
