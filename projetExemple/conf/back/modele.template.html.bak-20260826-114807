    .drag:hover, .drag:active { background: var(--border-action-high-blue-france); }
    .drag.l { right: -4px; }
    .drag.r { left: -4px; }

        .sidebar-right div::-webkit-scrollbar { display: none; }
    
    /* Design Modal Paramètres */
    .custom-segmented-control { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
    .custom-segmented-control label { flex: 1; cursor: pointer; margin: 0; }
    .custom-segmented-control input { display: none; }
    .custom-segmented-control span { 
      display: block; text-align: center; padding: 0.5rem 1rem; 
      border: 1px solid var(--border-default-grey); border-radius: 0.25rem; 
      background: var(--background-default-grey); font-weight: bold;
      transition: all 0.2s; 
    }
    .custom-segmented-control input:checked + span {
      background: var(--background-active-blue-france); color: #fff; border-color: var(--background-active-blue-france);
    }
    
    /* Application des paramètres */
    .main-content-area[data-font="S"] p, .main-content-area[data-font="S"] li { font-size: 0.875rem; line-height: 1.5; }
    .main-content-area[data-font="M"] p, .main-content-area[data-font="M"] li { font-size: 1rem; line-height: 1.5; }
    .main-content-area[data-font="L"] p, .main-content-area[data-font="L"] li { font-size: 1.125rem; line-height: 1.6; }
    .main-content-area[data-justify="true"] p { text-align: justify; hyphens: auto; }
    .main-content-area[data-justify="false"] p { text-align: left; }

    
    /* Header compact */
    .fr-header__body-row { padding: 0.25rem 0 !important; margin-left: 0 !important; margin-right: 0 !important; }
    .fr-header__service { padding-top: 0.25rem !important; padding-bottom: 0.25rem !important; }
    .fr-header__brand { margin-top: 0 !important; margin-bottom: 0 !important; }
    .fr-header .fr-logo { font-size: 0.85rem !important; padding: 0.5rem !important; }
    .fr-header__service-title { font-size: 1.1rem !important; line-height: 1.2 !important; margin-bottom: 0 !important; }
    .fr-header__service-tagline { font-size: 0.85rem !important; line-height: 1.2 !important; margin-top: 0.25rem !important; }

    /* Layout */
    .layout-wrapper { min-height: 100vh; }
    .main-content-area { flex: 1; }
  </style>

  <script>
    var scheme = localStorage.getItem('scheme') || 'system';
    document.documentElement.setAttribute('data-fr-theme', scheme);
    var savedZoom = localStorage.getItem('liseuse-zoom') || '90%';
    document.documentElement.style.zoom = savedZoom;
  </script>
</head>

<body class="layout-wrapper" style="width: 100%; max-width: 100%; background-color: var(--background-default-grey);">

  <header role="banner" class="fr-header">
    <div class="fr-header__body">
      <div class="fr-container--fluid" style="margin-left: 18px; margin-right: 10px;">
        <div class="fr-header__body-row">
          <div class="fr-header__brand fr-enlarge-link">
            <div class="fr-header__brand-top">
              <div class="fr-header__logo">
                <p class="fr-logo">
                  République<br>Française
                </p>
              </div>
              <div class="fr-header__navbar">
                <button class="fr-btn--menu fr-btn" data-fr-opened="false" aria-controls="modal-499" aria-haspopup="menu" id="button-500" title="Menu">
                  Menu
                </button>
              </div>
            </div>
            <div class="fr-header__service">
              <a href="$library-basedir$index.html" title="Accueil - SDS">
                <p class="fr-header__service-title">
                  <img src="$library-basedir$resources/img/logoMiniSDS03.png" alt="Logo SDS" style="height:24px; vertical-align:middle; margin-right:8px;">
                  SDS - Documentation Fonctionnelle
                </p>
              </a>
              <p class="fr-header__service-tagline">$if(title)$$title$$else$Document$endif$</p>
            </div>
          </div>
          <div class="fr-header__tools">
            <div class="fr-header__tools-links">
              <ul class="fr-btns-group">
                <li>
                  <div class="fr-btn" style="padding-left: 0.5rem; padding-right: 0.5rem; cursor: default;">
                    <span id="zoom-out-btn" class="fr-icon-subtract-line" title="Réduire le zoom" style="cursor: pointer; padding: 0 0.25rem;" aria-hidden="true"></span>
                    <span id="zoom-level-display" style="font-weight: bold; font-size: 0.875rem; min-width: 4ch; text-align: center; user-select: none; margin: 0 0.25rem; line-height: 1;">90%</span>
                    <span id="zoom-in-btn" class="fr-icon-add-line" title="Agrandir le zoom" style="cursor: pointer; padding: 0 0.25rem;" aria-hidden="true"></span>
                  </div>
                </li>
                <li>
                  <button class="fr-btn fr-icon-search-line" aria-controls="modal-search" data-fr-opened="false">
                    Rechercher
                  </button>
                </li>
                <li>
                  <button class="fr-btn fr-icon-theme-fill" aria-controls="fr-theme-modal" data-fr-opened="false">
                    Paramètres d'affichage
                  </button>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Menu mobile -->
    <div class="fr-header__menu fr-modal" id="modal-499" aria-labelledby="button-500">
      <div class="fr-container--fluid">
        <button class="fr-btn--close fr-btn" aria-controls="modal-499" title="Fermer">Fermer</button>
        <div class="fr-header__menu-links"></div>
      </div>
    </div>
  </header>

  <div class="fr-container--fluid fr-mt-4w main-content-area">
    <div class="fr-grid-row fr-grid-row--gutters" style="margin-left: 10px; margin-right: 10px;">
      
      <!-- Bibliothèque (Menu latéral gauche) -->
      <nav class="fr-sidemenu fr-col-12 sidebar-left" aria-label="Menu latéral">
        <div class="drag l" id="drag-left"></div>
        <div class="fr-sidemenu__inner">
          <button class="fr-sidemenu__btn" aria-controls="fr-sidemenu-wrapper" aria-expanded="false">Bibliothèque</button>
          <div class="fr-collapse" id="fr-sidemenu-wrapper">
            <div class="fr-sidemenu__title">Bibliothèque</div>
            <div class="fr-search-bar fr-mb-2w" id="lib-search-bar" role="search">
              <input class="fr-input" placeholder="Filtrer..." type="search" id="lib-search" name="lib-search">
              <button class="fr-btn" title="Rechercher">Rechercher</button>
            </div>
            <ul class="fr-sidemenu__list">
$if(library)$
$for(library)$
              <li class="fr-sidemenu__item lib-group">
                <button class="fr-sidemenu__btn" aria-expanded="false" aria-controls="sidemenu-$library.label$">$library.label$</button>
                <div class="fr-collapse" id="sidemenu-$library.label$">
                  <ul class="fr-sidemenu__list">
$for(library.items)$
                    <li class="fr-sidemenu__item">
                      <a class="fr-sidemenu__link lib-item" href="$library-basedir$$library.items.href$" data-href="$library-basedir$$library.items.href$">$library.items.title$</a>
                    </li>
$endfor$
                  </ul>
                </div>
              </li>
$endfor$
$else$
              <li class="fr-sidemenu__item">
                <a class="fr-sidemenu__link" href="#" aria-current="page">$if(title)$$title$$else$Document$endif$</a>
              </li>
$endif$
            </ul>
          </div>
        </div>
      </nav>

      <!-- Contenu principal -->
      <main class="fr-col-12 main-fluid" id="main-content" role="main">
$if(subtitle)$
        <div style="margin-bottom: 2rem;"><span class="fr-badge fr-badge--info">$subtitle$</span></div>
$endif$
        <div class="title-wrapper"><h1>$if(title)$$title$$else$Document$endif$</h1></div>
$if(abstract-title)$
        <p class="fr-text--lead">$abstract-title$</p>
$endif$
$if(abstract)$
        <p class="fr-text--lead">$abstract$</p>
$endif$
        
        <hr class="fr-hr fr-mt-4w fr-mb-4w">
        
        <div class="reading-content fr-text--regular">
$body$
        </div>
        
        
      </main>

      <!-- Sommaire (droite) -->
      <aside class="fr-col-12 sidebar-right">
        <div class="drag r" id="drag-right"></div>
        <div style="position: sticky; top: 1rem;">
          <div style="max-height: calc(100vh - 2rem); overflow-y: auto; padding-right: 5px;">
$if(photo)$
          <div class="fr-mb-2w">
            <img src="$library-basedir$$photo$" alt="" class="fr-responsive-img" style="border-radius:0.25rem; height:120px; width:100%; object-fit:cover; object-position:top;">
          </div>
$endif$
          <div class="fr-mb-2w fr-text--bold">Dans ce document</div>
$if(table-of-contents)$
          <nav id="TOC" role="doc-toc" $if(toc-depth)$data-toc-depth="$toc-depth$"$endif$>
          $table-of-contents$
          </nav>
$else$
          <p class="fr-text--sm fr-text-mention--grey">Compilez avec <code>--toc</code> pour afficher le sommaire.</p>
$endif$
          </div>
        </div>
      </aside>
      
    </div>
  </div>

  

  <!-- Modal Recherche Globale -->
  <dialog aria-labelledby="fr-modal-search-title" id="modal-search" class="fr-modal" role="dialog">
    <div class="fr-container--fluid fr-container-md">
      <div class="fr-grid-row fr-grid-row--center">
        <!-- Wrapper redimensionnable -->
        <div style="margin: 0 auto; width: 66vw; min-width: 300px; max-width: 95vw; height: 60vh; min-height: 250px; max-height: 90vh; resize: both; overflow: auto; padding-right: 15px; padding-bottom: 15px;">
