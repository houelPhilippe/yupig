<!DOCTYPE html>
<html lang="$if(lang)$$lang$$else$fr$endif$" data-fr-scheme="system">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="generator" content="pandoc + DSFR">
$for(author-meta)$
  <meta name="author" content="$author-meta$">
$endfor$
