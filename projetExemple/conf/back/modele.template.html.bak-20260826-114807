  <!-- Script DSFR -->
  <script type="module" src="$library-basedir$resources/dsfr/dist/dsfr.module.js"></script>
  
  <!-- Logique spécifique -->
  <script>
    (function(){
      "use strict";

      // 1. Activer le menu de gauche pour la page courante
      var here = decodeURIComponent(location.pathname.split(/[\\/]/).pop() || '');
      var libItems = Array.prototype.slice.call(document.querySelectorAll('.lib-item'));
      libItems.forEach(function(a){
        var href = a.getAttribute('data-href');
        if(href && here && decodeURIComponent(href.split(/[\\/]/).pop()) === here){
          a.setAttribute('aria-current', 'page');
          var parentGroup = a.closest('.lib-group');
          if (parentGroup) {
            var btn = parentGroup.querySelector('.fr-sidemenu__btn');
            if (btn) btn.setAttribute('aria-expanded', 'true');
          }
        }
      });

      // 2. Filtre Bibliothèque
      var libSearch = document.getElementById('lib-search');
      if (libSearch) {
        libSearch.addEventListener('input', function(){
          var q = this.value.trim().toLowerCase();
          document.querySelectorAll('.lib-group').forEach(function(g){
            var items = g.querySelectorAll('.lib-item');
            var vis = false;
            items.forEach(function(item){
              var t = item.textContent.toLowerCase();
              var match = !q || t.indexOf(q) !== -1;
              item.closest('li.fr-sidemenu__item').style.display = match ? '' : 'none';
              if (match) vis = true;
            });
            g.style.display = vis ? '' : 'none';
            if(q && vis) {
              var btn = g.querySelector('.fr-sidemenu__btn');
              if (btn) btn.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }

      // 3. Sommaire actif (Scroll Spy)
      var main = document.getElementById('main-content');
      var headings = Array.prototype.slice.call(main.querySelectorAll('h2, h3, h4, h5, h6')).filter(function(h){ return h.id; });
      var tocLinks = Array.prototype.slice.call(document.querySelectorAll('#TOC a'));
      var tocById = {};
      tocLinks.forEach(function(a){
        var href = a.getAttribute('href') || '';
        if(href.charAt(0) === '#') tocById[href.slice(1)] = a;
      });

      function updateActiveToc(){
        if(!headings.length) return;
        var top = window.scrollY + 100;
        var current = headings[0];
        for(var i=0;i<headings.length;i++){
          if(headings[i].offsetTop <= top) current = headings[i]; else break;
        }
        tocLinks.forEach(function(a){ a.classList.remove('active'); });
        var link = tocById[current.id];
        if(link){ link.classList.add('active'); }
      }
      window.addEventListener('scroll', updateActiveToc, { passive:true });

      // 4. Recherche globale
      var pInput = document.getElementById('palette-input');
      var pResults = document.getElementById('palette-results');
      var searchDebounce = null;
      var globalSearchCache = null;

      async function buildSearchCache() {
        if (globalSearchCache) return globalSearchCache;
        globalSearchCache = [];
        var promises = libItems.map(async function(item) {
          var url = item.getAttribute('data-href');
          if(!url) return;
          var docTitle = item.textContent || '';
          try {
            var res = await fetch(url);
            var html = await res.text();
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var elements = Array.prototype.slice.call(doc.querySelectorAll('.reading-content h1, .reading-content h2, .reading-content h3, .reading-content h4, .reading-content h5, .reading-content h6, .reading-content p, .reading-content li'));
            var searchable = elements.map(function(el) {
              var idEl = el.closest('[id]') || el;
              return { text: el.textContent.replace(/\s+/g, ' ').trim(), id: idEl.id || '', tag: el.tagName };
            }).filter(function(e) { return e.text.length > 0; });
            globalSearchCache.push({ url: url, title: docTitle, elements: searchable });
          } catch(e) { console.error('Erreur fetch', url, e); }
        });
        await Promise.all(promises);
        return globalSearchCache;
      }

      async function renderPalette(q){
        q = q.trim().toLowerCase();
        if (!q) {
          pResults.innerHTML = '<p class="fr-text--sm">Saisissez un texte...</p>';
          return;
        }
        pResults.innerHTML = '<p class="fr-text--sm">Recherche en cours...</p>';

        var cache = await buildSearchCache();
        var results = [];
        
        for (var i = 0; i < cache.length; i++) {
          var doc = cache[i];
          for (var j = 0; j < doc.elements.length; j++) {
            var el = doc.elements[j];
            var idx = el.text.toLowerCase().indexOf(q);
            if (idx !== -1) {
              var start = Math.max(0, idx - 40);
              var end = Math.min(el.text.length, idx + q.length + 40);
              var excerpt = (start > 0 ? '...' : '') + el.text.substring(start, end) + (end < el.text.length ? '...' : '');
              results.push({
                docUrl: doc.url,
                docTitle: doc.title,
                excerpt: excerpt,
                id: el.id,
                tag: el.tag
              });
            }
            if (results.length >= 50) break;
          }
          if (results.length >= 50) break;
        }

        if(!results.length){ pResults.innerHTML = '<p class="fr-text--sm">Aucun résultat trouvé</p>'; return; }

        pResults.innerHTML = '<ul class="fr-links-group" style="list-style:none; padding:0; text-align:left;"></ul>';
        var ul = pResults.querySelector('ul');

        results.forEach(function(r, i){
          var li = document.createElement('li');
          li.style.marginBottom = '1rem';
          var a = document.createElement('a');
          a.href = r.docUrl + '?sq=' + encodeURIComponent(q) + (r.id ? '#' + r.id : '');
          a.className = 'fr-link';
          
          var safeExcerpt = r.excerpt.replace(/</g, '&lt;').replace(/>/g, '&gt;');
          var reg = new RegExp('(' + q.replace(/[.*+?^$${}()|[\]\\]/g, '\\$$&') + ')', 'gi');
          var highlightedExcerpt = safeExcerpt.replace(reg, '<mark>$$1</mark>');

          a.innerHTML = '<strong>' + r.docTitle + '</strong> <span class="fr-badge fr-badge--sm fr-badge--info fr-ml-1w">' + r.tag + '</span><br><span class="fr-text--xs fr-text-default--grey">' + highlightedExcerpt + '</span>';
          li.appendChild(a);
          ul.appendChild(li);
        });
      }

      if(pInput) {
        pInput.addEventListener('input', function(){
          clearTimeout(searchDebounce);
          searchDebounce = setTimeout(function() {
            renderPalette(pInput.value);
          }, 200);
        });

        window.addEventListener('keydown', function(e){
          if((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')){ 
            e.preventDefault(); 
            var btn = document.querySelector('[aria-controls="modal-search"]');
            if(btn) btn.click();
            setTimeout(function() { pInput.focus(); buildSearchCache(); }, 100);
          }
        });
      }

      var modalSearchBtn = document.querySelector('[aria-controls="modal-search"]');
      if (modalSearchBtn) {
        modalSearchBtn.addEventListener('click', function() {
          setTimeout(function() { if(pInput) pInput.focus(); buildSearchCache(); }, 100);
        });
      }

      // 6. Surlignage de la recherche depuis l'URL
      (function(){
        var params = new URLSearchParams(window.location.search);
        var sq = params.get('sq');
        if(sq){
          sq = sq.trim().toLowerCase();
          var firstMark = null;
          function highlightText(node) {
            if(firstMark) return;
            if(node.nodeType === 3) {
              var idx = node.nodeValue.toLowerCase().indexOf(sq);
              if(idx !== -1) {
                var mark = document.createElement('mark');
                mark.textContent = node.nodeValue.substring(idx, idx + sq.length);
                var after = node.splitText(idx);
                after.nodeValue = after.nodeValue.substring(sq.length);
                node.parentNode.insertBefore(mark, after);
                firstMark = mark;
              }
            } else if(node.nodeType === 1 && node.tagName !== 'MARK' && node.tagName !== 'SCRIPT' && node.tagName !== 'STYLE') {
              var children = Array.prototype.slice.call(node.childNodes);
              for(var i = 0; i < children.length; i++) {
                highlightText(children[i]);
              }
            }
          }
          var article = document.querySelector('.reading-content');
          if(article) {
            highlightText(article);
            if(firstMark) {
              setTimeout(function(){
                firstMark.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }, 150);
            }
          }
        }
      })();

    })();
  </script>

  <script>
  /* ---------- Redimensionnement des panneaux ---------- */
  function makeDrag(handle, side){
    if(!handle) return;
    handle.addEventListener('mousedown', function(e){
      e.preventDefault();
      var startX = e.clientX;
      var prop = side === 'left' ? '--left-w' : '--right-w';
      var start = parseInt(getComputedStyle(document.body).getPropertyValue(prop)) || 320;
      function move(ev){
        var d = ev.clientX - startX;
        var w = side === 'left' ? start + d : start - d;
        w = Math.max(200, Math.min(600, w));
        document.body.style.setProperty(prop, w + 'px');
      }
      function up(){
        document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up); document.body.style.userSelect='';
        try{ localStorage.setItem('liseuse-'+prop.slice(2), getComputedStyle(document.body).getPropertyValue(prop).trim()); }catch(e){}
      }
      document.body.style.userSelect = 'none';
      document.addEventListener('mousemove', move);
      document.addEventListener('mouseup', up);
    });
  }
  makeDrag(document.getElementById('drag-left'), 'left');
  makeDrag(document.getElementById('drag-right'), 'right');
  
  
  
  
  // Fallback d'ouverture et gestion de tous les paramètres
  (function(){
    var themeBtn = document.querySelector('[aria-controls="fr-theme-modal"]');
    var themeModal = document.getElementById('fr-theme-modal');
    if(themeBtn && themeModal) {
      themeBtn.addEventListener('click', function(e) { themeModal.classList.add('fr-modal--opened'); });
      var closeBtns = themeModal.querySelectorAll('.fr-btn--close');
      closeBtns.forEach(function(btn) { btn.addEventListener('click', function(e) { themeModal.classList.remove('fr-modal--opened'); }); });

      var mainArea = document.querySelector('.main-content-area');

      // Pour les selecteurs (Selects natifs DSFR)
      function setupSelectSetting(name, attrName, defaultValue, targetEl) {
        var select = themeModal.querySelector('select[name="' + name + '"]');
        var savedValue = localStorage.getItem('liseuse-' + name) || defaultValue;
        if(targetEl) targetEl.setAttribute(attrName, savedValue);
        if(select) {
          select.value = savedValue;
          select.addEventListener('change', function(e) {
            if(targetEl) targetEl.setAttribute(attrName, e.target.value);
            localStorage.setItem('liseuse-' + name, e.target.value);
          });
        }
      }

      // Pour le thème (Radios riches)
      var themeRadios = themeModal.querySelectorAll('input[name="fr-radios-theme"]');
      var currentScheme = localStorage.getItem('scheme') || 'system';
      themeRadios.forEach(function(radio) {
        if(radio.value === currentScheme) radio.checked = true;
        radio.addEventListener('change', function(e) {
          if(e.target.checked) {
            document.documentElement.setAttribute('data-fr-theme', e.target.value);
            localStorage.setItem('scheme', e.target.value);
          }
        });
      });

      setupSelectSetting('font-family', 'data-font-family', 'Sans', mainArea);
      setupSelectSetting('font-size', 'data-font-size', 'M', mainArea);
      setupSelectSetting('text-justify', 'data-justify', 'false', mainArea);
      setupSelectSetting('line-height', 'data-line-height', 'Normal', mainArea);
      setupSelectSetting('col-width', 'data-col-width', 'XL', mainArea);
      setupSelectSetting('heading-spacing', 'data-heading-spacing', 'Normal', mainArea);
      setupSelectSetting('para-spacing', 'data-para-spacing', 'Normal', mainArea);
      setupSelectSetting('list-spacing', 'data-list-spacing', 'Normal', mainArea);
      setupSelectSetting('scrollbar', 'data-scrollbar', 'Masque', document.documentElement);
    }
  })();

  // Restore saved sizes
  try {
    var l = localStorage.getItem('liseuse-left-w');
    var r = localStorage.getItem('liseuse-right-w');
    if (l) document.body.style.setProperty('--left-w', l);
    if (r) document.body.style.setProperty('--right-w', r);
  } catch(e) {}
</script>


  <!-- Gestion du Zoom -->
  <script>
    (function() {
      var btnOut = document.getElementById('zoom-out-btn');
      var btnIn = document.getElementById('zoom-in-btn');
      var display = document.getElementById('zoom-level-display');
      
      if (btnOut && btnIn && display) {
        var zoomLevels = [50, 75, 80, 90, 100, 110, 125, 150, 175, 200];
        var currentZoomStr = localStorage.getItem('liseuse-zoom') || '90%';
        var currentZoom = parseInt(currentZoomStr, 10);
        if(isNaN(currentZoom)) currentZoom = 90;
        
        function applyZoom(z) {
          currentZoom = z;
          var val = z + '%';
          display.textContent = val;
          document.documentElement.style.zoom = val;
          localStorage.setItem('liseuse-zoom', val);
        }
        
        applyZoom(currentZoom);
        
        btnOut.addEventListener('click', function() {
          var next = currentZoom;
          for(var i = zoomLevels.length - 1; i >= 0; i--) {
            if(zoomLevels[i] < currentZoom) { next = zoomLevels[i]; break; }
          }
          applyZoom(next);
        });
        
        btnIn.addEventListener('click', function() {
          var next = currentZoom;
          for(var i = 0; i < zoomLevels.length; i++) {
            if(zoomLevels[i] > currentZoom) { next = zoomLevels[i]; break; }
          }
          applyZoom(next);
        });
      }
    })();
  </script>

