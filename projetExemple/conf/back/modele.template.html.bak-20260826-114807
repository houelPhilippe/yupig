            <div class="fr-modal__header">
              <button class="fr-btn--close fr-btn" aria-controls="modal-search" title="Fermer">Fermer</button>
            </div>
            <div class="fr-modal__content" style="flex: 1; display: flex; flex-direction: column; overflow-y: auto;">
              <h1 id="fr-modal-search-title" class="fr-modal__title">
                <span class="fr-icon-search-line fr-icon--lg"></span>
                Recherche globale
              </h1>
              <div class="fr-search-bar" id="search-bar-global" role="search">
                <input class="fr-input" placeholder="Rechercher dans tous les documents... (⌘K)" type="search" id="palette-input" name="search-input">
                <button class="fr-btn" title="Rechercher">Rechercher</button>
              </div>
              <div class="fr-mt-2w" id="palette-results" style="flex: 1; overflow-y: auto; padding-right: 0.5rem;">
                <!-- Résultats de recherche -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  
  
  
  <!-- Modal Paramètres d'affichage -->
  <dialog id="fr-theme-modal" class="fr-modal" role="dialog" aria-labelledby="fr-theme-modal-title">
    <div class="fr-container fr-container--fluid fr-container-md">
      <div class="fr-grid-row fr-grid-row--center">
        <!-- Fenêtre large -->
        <div class="fr-col-12 fr-col-md-10 fr-col-lg-8">
          <div class="fr-modal__body">
            <div class="fr-modal__header">
              <button class="fr-btn--close fr-btn" aria-controls="fr-theme-modal" title="Fermer">Fermer</button>
            </div>
            <div class="fr-modal__content" style="flex: 1; display: flex; flex-direction: column; overflow-y: auto;">
              <h1 id="fr-theme-modal-title" class="fr-modal__title">
                <span class="fr-icon-settings-5-line fr-icon--lg"></span>
                Paramètres d’affichage
              </h1>
              
              <div class="fr-grid-row fr-grid-row--gutters fr-mb-4w">
                
                <!-- Colonne 1 -->
