{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Éditeur Markdown",
  "version": "1.1.3",
  "identifier": "fr.phl.veille",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Éditeur Markdown",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f3f2f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../projetExemple/confModele": "confModele"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Éditeur Markdown",
    "longDescription": "Éditeur Markdown autonome : rédaction des documents d'un projet, compilation par Pandoc, et un agrégateur de flux RSS/Atom en option. Hors ligne."
  }
}
