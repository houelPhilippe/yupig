{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veille",
  "version": "1.0.2",
  "identifier": "fr.phl.veille",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tableau de bord Veille",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f3f2f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "News",
    "shortDescription": "Agrégateur de veille",
    "longDescription": "Tableau de bord de veille autonome : collecte de flux RSS/Atom, lecture, favoris et recherche, hors ligne."
  }
}
